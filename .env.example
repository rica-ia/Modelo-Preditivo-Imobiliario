# Copie para .env e preencha. O .env nunca vai para o Git.
AVALIADOR_ADMIN_TOKEN=
SMTP_HOST=smtp.gmail.com
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA_APP=
SMTP_REMETENTE_NOME=Avaliador Imobiliário
AVALIADOR_BANCO=modulo2_api/banco/avaliador.db
GOOGLE_MAPS_API_KEY=
# Acesso ao console com senha + 2FA (opcional). O segredo é gerado por:
#   python -m modulo2_api.ferramentas.configurar_2fa
# Senha própria, gravada só como hash por: python -m modulo2_api.ferramentas.configurar_2fa --senha
# Sem hash e sem AVALIADOR_SENHA_ACESSO, vale a SMTP_SENHA_APP.
AVALIADOR_TOTP_SEGREDO=
AVALIADOR_SENHA_HASH=
AVALIADOR_SENHA_ACESSO=
